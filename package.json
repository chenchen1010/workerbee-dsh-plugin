{
  "name": "@workerbee/dsh-xhs-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "工蜂 · 小红书真机采集工作台（DeepSeek Harness 插件，源码开放）",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
